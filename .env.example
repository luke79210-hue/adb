# 複製為 .env，僅供 scripts/run-service.sh / LaunchAgent 載入。
# .env 不會提交；請 chmod 600 .env。勿將公司憑證放進 web/。
# 正式使用前，請向內部確認奧創 APP 的 Package Name。
ULTRON_PACKAGE=com.ultron.app
# ADB_PATH=/opt/homebrew/bin/adb
# GOOGLE_DRIVE_FOLDER_ID=公司專用資料夾ID
# GOOGLE_DRIVE_ACCESS_TOKEN=具該資料夾存取權的OAuth-access-token
# ULTRON_ALLOWED_ORIGINS=https://your-account.github.io
